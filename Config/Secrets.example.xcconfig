// Copy to Config/Secrets.xcconfig and fill in. That file is git-ignored.
TESLALINK_BUNDLE_ID = com.yourname.teslalink
TESLALINK_TEAM_ID = ABCDE12345
TESLA_CLIENT_ID = your-client-id-from-developer.tesla.com
TESLA_CLIENT_SECRET = your-client-secret
TESLA_REDIRECT_URI = https:/$()/yourdomain.com/teslalink/callback
